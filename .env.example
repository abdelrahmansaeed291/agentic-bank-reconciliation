# Demo mode is the default and needs no API keys.
LLM_PROVIDER=demo
BANKING_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8000

# Optional AWS Bedrock mode (credentials must come from your AWS profile/role, never this file).
# Set true before building the agent container with Docker Compose.
INSTALL_BEDROCK=false
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
